# Example keystore configuration — DO NOT COMMIT a real keystore file.
#
# 1. Generate a release keystore (one-time, on a machine you control):
#
#      keytool -genkey -v -keystore khanalagao-release.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias khanalagao
#
# 2. Store these env vars locally (e.g. in apps/android/.env, gitignored):
#
#      KEYSTORE_PATH=/absolute/path/to/khanalagao-release.jks
#      KEYSTORE_PASSWORD=...
#      KEY_ALIAS=khanalagao
#      KEY_PASSWORD=...
#
# 3. In android/app/build.gradle, reference them via signingConfigs:
#
#      signingConfigs {
#        release {
#          storeFile file(System.getenv("KEYSTORE_PATH"))
#          storePassword System.getenv("KEYSTORE_PASSWORD")
#          keyAlias System.getenv("KEY_ALIAS")
#          keyPassword System.getenv("KEY_PASSWORD")
#        }
#      }
#      buildTypes { release { signingConfig signingConfigs.release } }
#
# 4. Run `pnpm --filter @workspace/android build:aab` to produce a signed
#    Play-Store-ready bundle at android/app/build/outputs/bundle/release/.
