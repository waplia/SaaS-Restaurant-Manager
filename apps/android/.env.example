# URL the Android WebView loads. Mirrors capacitor.config.json so the
# fallback www/index.html can redirect to it if Capacitor's server.url is
# overridden at build time.
APP_URL=https://khanalagao.com/app/

# Optional API base override. Leave empty unless pointing at staging.
API_URL=

# Release signing — see keystore.example. Do NOT commit real values.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
