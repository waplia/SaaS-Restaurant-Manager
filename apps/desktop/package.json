{
  "name": "@workspace/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop wrapper for the Khana Lagao Restaurant Platform.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:installer": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "release:win": "electron-builder --win nsis --publish always",
    "release:mac": "electron-builder --mac dmg --publish always",
    "release:linux": "electron-builder --linux AppImage --publish always"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "node-thermal-printer": "^4.4.5"
  },
  "build": {
    "appId": "com.khanalagao.desktop",
    "productName": "Khana Lagao",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.cjs"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khanalagao",
        "repo": "khanalagao",
        "releaseType": "draft"
      }
    ]
  }
}
