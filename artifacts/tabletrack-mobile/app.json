{
  "expo": {
    "name": "KhanaLagao Restaurant",
    "slug": "tabletrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tabletrack-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow KhanaLagao to use the microphone so you can dictate orders with voice."
      }
    },
    "android": {
      "package": "com.khanalagao.restaurant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f97316"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KhanaLagao Restaurant to use the camera so you can scan table QR codes and menu barcodes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow KhanaLagao to use the microphone so you can dictate orders with voice."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#f97316",
          "sounds": [
            "./assets/sounds/new-order.wav",
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "59b572a3-78e4-4910-a082-850ac1e42657"
      }
    },
    "owner": "waplias-organization"
  }
}
